{
	"name": "subatom",
	"version": "2.0.1",
	"description": "Subatom is a modern, high-performance, enterprise-grade web framework for Node.js.",
	"keywords": [
		"subatom",
		"framework",
		"node",
		"nodejs",
		"backend",
		"web",
		"http",
		"server",
		"rest",
		"rest-api",
		"api",
		"router",
		"typescript",
		"fast",
		"performance",
		"enterprise"
	],
	"homepage": "https://github.com/subatomjs/subatom#readme",
	"bugs": {
		"url": "https://github.com/subatomjs/subatom/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/subatomjs/subatom.git"
	},
	"license": "MIT",
	"author": "Kunal Chandra Das <kunal@subatomjs.dev>",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js",
			"default": "./dist/types.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"subatom": "./dist/start/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"build": "npm run clean && npm run typecheck && tsdown",
		"postbuild": "tsx ./start/postbuild.ts",
		"build:watch": "tsdown --watch",
		"dev": "tsx watch ./index.ts",
		"cli:dev": "tsx watch ./start/cli.ts",
		"lint": "biome check .",
		"lint-fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"pre:commit": "npm run clean && npm run build && npm run postbuild && npm run lint-fix && npm run test:coverage"
	},
	"dependencies": {
		"@parcel/watcher": "^2.6.0",
		"busboy": "^1.6.0",
		"commander": "^15.0.0",
		"esbuild": "^0.28.1",
		"picocolors": "^1.1.1",
		"subatom-infer": "^1.3.7",
		"tsx": "^4.23.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/busboy": "^1.5.4",
		"@types/node": "^26.4.1",
		"@vitest/coverage-v8": "^4.1.10",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false
}
