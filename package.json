{
  "name": "subatom",
  "version": "0.2.0",
  "description": "Subatom is a modern, high-performance, enterprise-grade web framework for Node.js.",
  "license": "MIT",
  "author": "Kunal Chandra Das <kunalchandradasofficial@gmail.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "subatom": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "subatom",
    "framework",
    "node",
    "nodejs",
    "backend",
    "web",
    "http",
    "server",
    "rest",
    "rest-api",
    "api",
    "router",
    "typescript",
    "fast",
    "performance",
    "enterprise"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subatomjs/subatom.git"
  },
  "bugs": {
    "url": "https://github.com/subatomjs/subatom/issues"
  },
  "homepage": "https://github.com/subatomjs/subatom#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch ./src/index.ts",
    "cli:dev": "tsx watch ./src/cli.ts",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "commander": "^15.0.0",
    "esbuild": "^0.28.1",
    "picocolors": "^1.1.1",
    "tsx": "^4.23.5"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
