{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],

		"module": "NodeNext",
		"moduleResolution": "NodeNext",

		"types": ["node"],

		"rootDir": "./src",
		"outDir": "./dist",

		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,

		"strict": true,
		"noImplicitAny": true,
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,

		"forceConsistentCasingInFileNames": true,

		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,

		"resolveJsonModule": true,
		"isolatedModules": true,

		"skipLibCheck": true,

		"removeComments": true,
		"noEmitOnError": true,

		"incremental": false
	},

	"include": ["src"],

	"exclude": ["dist", "node_modules", "playground", "tests"]
}
