{
	"extends": "./tsconfig.json",

	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./",
		"declarationMap": false,
		"sourceMap": false
	},

	"include": ["index.ts", "./**/*.ts", "package/**/*.ts"],

	"exclude": [
		"playground",
		"playgrounds",
		"test",
		"tests",
		"dist",
		"build",
		"node_modules",
		"sample",
		"samples",
		"example",
		"examples"
	]
}
